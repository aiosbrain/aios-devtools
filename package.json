{
  "name": "@aiosbrain/aios-devtools",
  "version": "0.3.0",
  "description": "AIOS devtools — the ship/build/roadmap-run/spec-eval/spec-publish/consolidate-findings command set, cut from aiosbrain/aios-workspace (AIO-594). Toolkit-seam functionality requires an AIOS toolkit checkout via AIOS_TOOLKIT_DIR or --toolkit-dir (docs/devtools-toolkit-contract.md).",
  "type": "module",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aiosbrain/aios-devtools.git"
  },
  "homepage": "https://github.com/aiosbrain/aios-devtools#readme",
  "bugs": {
    "url": "https://github.com/aiosbrain/aios-devtools/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "aios-devtools": "scripts/cli.mjs"
  },
  "exports": {
    ".": "./scripts/index.mjs",
    "./cli": "./scripts/cli.mjs",
    "./build": "./scripts/build.mjs",
    "./spec-eval": "./scripts/spec-eval.mjs",
    "./consolidate-findings": "./scripts/consolidate-findings.mjs",
    "./ship": "./scripts/ship.mjs",
    "./roadmap-run": "./scripts/roadmap-run.mjs",
    "./loop-models": "./scripts/loop-models.mjs",
    "./model-providers": "./scripts/model-providers.mjs",
    "./package.json": "./package.json"
  },
  "files": [
    "CHANGELOG.md",
    "scripts/",
    "docs/",
    "validation/agent-readiness-lib.mjs"
  ],
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "test": "node --test --test-force-exit test/*.test.mjs",
    "lint": "find scripts test -name '*.mjs' -print0 | xargs -0 -n1 node --check",
    "test:coverage": "c8 node --test --test-force-exit test/*.test.mjs"
  },
  "dependencies": {
    "@aiosbrain/foundation": "^0.1.0",
    "@anthropic-ai/sdk": "^0.115.0"
  },
  "devDependencies": {
    "c8": "^12.0.0"
  }
}
